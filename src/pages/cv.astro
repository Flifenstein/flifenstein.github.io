---
import Base from '../layouts/Base.astro';

const experience = [
  ['May 2026 – present', 'imec · aistack', 'AI R&D Product Manager, Ghent'],
  ['Nov 2025 – Apr 2026', 'OpenChip', 'AI Platform Product Owner, Ghent'],
  ['Mar – Nov 2025', 'Microsoft · AI for Good Lab', 'Product Management Intern, Brussels / remote'],
  ['Oct 2023 – Mar 2025', 'Twipe Digital Publishing', 'Product Owner, Leuven'],
  ['Feb – Sep 2023', 'Iris.AI × Aalto University', 'Research Intern, NLP / LLM evaluation, remote'],
];
const training = [
  ['Fall 2026', 'Better Futures Fellowship (AI Safety Collab)', 'In progress'],
  ['Sep – Dec 2026', 'SPAR Fellow', 'Evaluation Awareness Convergence'],
  ['Nov 2026', 'Technical AI Governance Forum (ERA × Oxford Martin AIGI)', 'London, 14–15 Nov (upcoming)'],
  ['Sep – Oct 2026', 'ML4Good', 'Technical bootcamp'],
  ['May 2026', 'BlueDot', 'Technical AI Safety'],
  ['Feb 2026', 'BlueDot', 'AGI Strategy'],
];
const education = [
  ['2021 – 2023', 'MSc Human–Computer Interaction & Design', 'EIT Digital double degree: University of Twente + Aalto University'],
  ['2017 – 2021', 'BSc Communication Science + Philosophy Honors', 'University of Twente'],
];
const sections = [
  ['Experience', experience],
  ['AI safety', training],
  ['Education', education],
] as const;
---

<Base title="CV · Ioana Frîncu (Frincu)" description="CV of Ioana Frîncu (Frincu): how I work, experience, AI safety and education.">
  <h1 class="page-title">CV</h1>
  <p><a class="button" href="/cv/ioana-frincu-cv.pdf">Download CV (PDF)</a></p>

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work">How I work</h2>
    <p>
      When it comes to who I am as a professional, I think SpongeBob with extra agency. I show up full of enthusiasm and fuelled by curiosity. I don't wait to be handed tasks, and I'm at my most useful when a group of people needs to get to the same goal. I take the
      boring tasks off people's plates so the experts can spend their time on the hard part.
    </p>
    <p>
      I use a lot of humour with the people I work with, and I step out of my comfort zone more often than I plan
      to. I'm happiest sitting next to
      engineers and researchers. But I've also done my share of sales and business work (a job is never only the parts you like), so I
      can switch between contexts fast enough without losing the thread.
    </p>
  </section>

  {
    sections.map(([heading, rows]) => (
      <section>
        <h2>{heading}</h2>
        <dl class="timeline">
          {rows.map(([when, what, detail]) => (
            <div>
              <dt>{when}</dt>
              <dd>
                {what}
                <br />
                <span class="meta">{detail}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</Base>
