---
import Base from '../layouts/Base.astro';

const experience = [
  ['May 2026 – present', 'imec · aistack', 'AI R&D Product Manager, Ghent'],
  ['Nov 2025 – Apr 2026', 'OpenChip', 'AI Platform Product Owner, Ghent'],
  ['Mar – Nov 2025', 'Microsoft · AI for Good Lab', 'Product Management Intern, Brussels / remote'],
  ['Oct 2023 – Mar 2025', 'Twipe Digital Publishing', 'Product Owner, Leuven'],
  ['Feb – Sep 2023', 'Iris.AI × Aalto University', 'Research Intern, NLP / LLM evaluation, remote'],
  ['Nov 2020 – Oct 2022', 'University of Twente', 'Teaching Assistant, Statistics & R programming, part-time, Enschede. Taught research methodology, linear regression, ANOVA and hypothesis testing; co-wrote an R intro tutorial for social-science students with no maths background'],
];
const training = [
  ['Fall 2026', 'Better Futures Fellowship (AI Safety Collab)', 'In progress'],
  ['Sep – Dec 2026', 'SPAR Fellow', 'Evaluation Awareness Convergence'],
  ['Nov 2026', 'Technical AI Governance Forum (ERA × Oxford Martin AIGI)', 'London, 14–15 Nov (upcoming)'],
  ['Sep – Oct 2026', 'ML4Good', 'Technical bootcamp'],
  ['May 2026', 'BlueDot', 'Technical AI Safety'],
  ['Feb 2026', 'BlueDot', 'AGI Strategy'],
];
type Bullet = [text: string, href?: string];
const education: [string, string, string, Bullet[]?][] = [
  [
    '2021 – 2023',
    'EIT Digital double degree: MSc Interaction Technology (University of Twente) + MSc (Tech) Human-Computer Interaction & Design (Aalto University)',
    '',
    [
      [
        'Thesis "In Search of the Perfect Prompt" (Aalto, 2023; supervisor Lauri Juvela; with Iris.AI): prompt-tuned GPT-2 and Falcon-7B (Hugging Face PEFT, PyTorch) and compared them with prompt-engineered GPT-3.5 for scientific abstract generation.',
        'https://aaltodoc.aalto.fi/items/170a001d-4e04-4a82-af04-ba386023ced4',
      ],
      ['Evaluated with ROUGE/F1, expert sensibleness/specificity/usefulness ratings, and a user study using the SASSI questionnaire (adapted for text).'],
    ],
  ],
  [
    '2017 – 2021',
    'BSc Communication Science, University of Twente (minor: internship)',
    '',
    [
      [
        'Thesis "Into the Q storm": mixed-methods study of QAnon online communities. Scraped Reddit with Python (PRAW), ran sentiment analysis in R (Harvard-IV, NRC lexicons), built a codebook and double-coded the data with a second coder (Cohen\'s κ).',
        'https://github.com/Flifenstein/BSc.-Thesis-Ioana-Frincu',
      ],
    ],
  ],
  [
    'Extracurricular',
    'Philosophy Honours Programme, University of Twente',
    'on top of the BSc',
  ],
];
// Courses from the official transcripts, picked for what matters to an advisor. No grades on purpose.
const thesis = 'https://urn.fi/URN:NBN:fi:aalto-202310156390';
const competencies: { area: string; note?: string; lead?: string; courses?: [string, string?, string?][] }[] = [
  {
    area: 'Statistics & math',
    note: 'Teaching assistant in statistics and R at the University of Twente, 2 years',
    courses: [
      ['Research Methods & Descriptive Statistics', undefined, 'research design, measurement reliability & validity, sampling, correlation, regression'],
      ['Inferential Statistics', undefined, 't-tests, chi-squared, multiple regression, one- and two-way anova'],
      ['Quantitative Data Analysis 1 and 2', undefined, 'hypothesis testing, anova, regression, probability, r'],
      ['Big Data Analytics'],
      ['Introduction to Mathematics + Calculus 1A'],
    ],
  },
  {
    area: 'Research methods',
    courses: [
      ['Concepts, Measures and Methods (MSc)', undefined, 'user research methods, interviews, surveys, diary & field studies, task analysis, card sorting, video coding'],
      ['Data Collection & Scale Development'],
      ['Qualitative Methodology 1–3'],
      ['Bachelor thesis'],
    ],
  },
  {
    area: 'ML & NLP',
    courses: [
      ['Machine Learning', undefined, 'regression, classification, clustering, pca, model validation, python, jupyter'],
      ['Statistical Natural Language Processing', undefined, 'n-gram & neural language models, hmms, word2vec, machine translation, research project'],
      ['MSc thesis: In Search of the Perfect Prompt', thesis],
    ],
  },
  {
    area: 'HCI',
    courses: [
      ['Introduction to Human–Computer Interaction', undefined, 'interaction design, evaluation metrics & instruments'],
      ['Human Centred Design', undefined, 'iterative hcd, prototyping, human-centred evaluation'],
      ['User Interface Construction', undefined, 'building interactive uis for usability testing'],
      ['Conversational Agents', undefined, 'dialogue annotation, inter-annotator reliability, built & tested a conversational agent'],
      ['Affective Computing', undefined, 'collected & annotated affect data, built & evaluated an emotion-recognition app, python, opencv'],
    ],
  },
  {
    area: 'Ethics & philosophy',
    courses: [
      ['Computer Ethics', undefined, 'privacy, ai, data analytics, professional responsibility, case-analysis essays'],
      ['Philosophy Honours Programme', undefined, 'primary philosophical sources, knowledge, ethics, philosophy of mind, two written synthesis essays'],
    ],
  },
  {
    area: 'Code',
    lead: 'Python, R, SQL, TypeScript, React',
    note: ' (used to know c++ and java)',
    courses: [['Full Stack Web Development', undefined, 'react, node.js, express, mongodb']],
  },
];
const sections = [
  ['Experience', experience],
  ['AI safety', training],
  ['Education', education],
] as const;
---

<Base title="CV · Ioana Frîncu (Frincu)" description="CV of Ioana Frîncu (Frincu): how I work, experience, AI safety and education.">
  <h1 class="page-title">CV</h1>
  <p><a class="button" href="/cv/ioana-frincu-cv.pdf">Download CV (PDF)</a></p>

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work">How I work</h2>
    <p>
      When it comes to who I am as a professional, think SpongeBob with extra agency. I show up full of enthusiasm and fuelled by curiosity. I don't wait to be handed tasks, and I'm at my most useful when a group of people needs to get to the same goal. I take the
      boring tasks off people's plates so the experts can spend their time on the hard part.
    </p>
    <p>
      I use a lot of humour with the people I work with, and I step out of my comfort zone more often than I plan
      to. I'm happiest sitting next to
      engineers and researchers. But I've also done my share of sales and business work (a job is never only the parts you like), so I
      can switch between contexts fast enough without losing the thread.
    </p>
  </section>

  {
    sections.map(([heading, rows]) => (
      <section>
        <h2>{heading}</h2>
        <dl class="timeline">
          {rows.map(([when, what, detail, bullets]) => (
            <div>
              <dt>{when}</dt>
              <dd>
                {what}
                {detail && <br />}
                {detail && <span class="meta">{detail}</span>}
                {bullets && (
                  <ul class="plain">
                    {bullets.map(([text, href]) => (
                      <li>
                        {text}
                        {href && (
                          <>
                            {' '}
                            <a href={href}>Link</a>
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }

  <section aria-labelledby="courses">
    <h2 id="courses">Courses &amp; competencies</h2>
    <dl class="timeline">
      {
        competencies.map((c) => (
          <div>
            <dt>{c.area}</dt>
            <dd>
              {c.lead}
              {c.note && (c.lead ? <span class="meta">{c.note}</span> : <p><strong>{c.note}</strong></p>)}
              {c.courses && (
                <ul class="plain">
                  {c.courses.map(([course, href, desc]) => (
                    <li>
                      {href ? <a href={href}>{course}</a> : course}
                      {desc && <span class="meta">{desc}</span>}
                    </li>
                  ))}
                </ul>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>
