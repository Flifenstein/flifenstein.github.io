---
import '@fontsource-variable/newsreader/index.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: boolean;
}
const {
  title,
  description = 'Ioana Frîncu (Frincu): research on AI evaluation and safety.',
  jsonLd = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/writing/', label: 'Writing' },
  { href: '/cv/', label: 'CV' },
  { href: '/#contact', label: 'Contact' },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ioana Frîncu',
  alternateName: 'Ioana Frincu',
  url: Astro.site?.toString(),
  affiliation: { '@type': 'Organization', name: 'imec' },
  sameAs: [
    'https://github.com/flifenstein',
    'https://www.linkedin.com/in/frincui',
    'https://flifenstein.com',
    'https://scholar.google.com/citations?user=Y2m2NaoAAAAJ',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ioana Frîncu (Ioana Frincu)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <!-- Apply a saved theme before first paint. No saved choice: the OS setting decides. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="home-link" href="/">Ioana Frîncu</a>
        <nav aria-label="Main">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode">theme</button>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">© 2026 Ioana Frîncu</div>
    </footer>
    <!-- The only client JS on the site -->
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var el = document.documentElement;
        var cur = el.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = cur === 'dark' ? 'light' : 'dark';
        el.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
